<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechShop</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="nav">
        <a class="logo" asp-controller="Home" asp-action="Index">TechShop</a>
        <nav>
            <a asp-controller="Home" asp-action="Index">Головна</a>
            <a asp-controller="Product" asp-action="Index">Товари</a>
            <a asp-controller="Home" asp-action="About">Про нас</a>
        </nav>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <footer class="footer">&copy; 2026 TechShop</footer>
</body>
</html>
