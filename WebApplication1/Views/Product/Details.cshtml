@model Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="card details">
    <div class="emoji big">@Model.Emoji</div>
    <div>
        <p class="muted">Товар #@Model.Id</p>
        <h1>@Model.Name</h1>
        <p>@Model.Description</p>
        <p class="price">@Model.Price.ToString("N0") грн</p>
        <a class="btn-main" asp-action="Index">← До списку товарів</a>
    </div>
</div>
